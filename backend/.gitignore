# ==============================================================================
# Django Backend .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Environment variables & secrets
.env
.env.*
!.env.example

# Unit test / coverage reporting
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Static root collected static
/static_collected/

# OS and IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
